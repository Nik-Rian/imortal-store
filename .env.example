# Database
DATABASE_URL="postgresql://username:password@localhost:5432/imortal_db?schema=public"

# Authentication (Better Auth)
BETTER_AUTH_SECRET="your_32_character_secret_key_here"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="https://your-ngrok-url.ngrok-free.app"

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token_here"
VERCEL_BLOB_HOSTNAMES="your_blob_id.public.blob.vercel-storage.com"

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN="your_mercadopago_access_token_here"
MERCADOPAGO_WEBHOOK_SECRET="your_mercadopago_webhook_secret_here"
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="your_mercadopago_public_key_here"
