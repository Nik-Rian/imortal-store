# Database
DATABASE_URL="postgresql://username:password@localhost:5432/imortal_db?schema=public"


# Integration tests: disposable database, wiped between tests. The database name MUST contain "test".
# Requires the generated Prisma client (pnpm exec prisma generate) before running pnpm test:integration.
TEST_DATABASE_URL="postgresql://username:password@localhost:5432/imortal_test"

# Authentication (Better Auth)
BETTER_AUTH_SECRET="your_32_character_secret_key_here"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="https://your-ngrok-url.ngrok-free.app"

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token_here"
VERCEL_BLOB_HOSTNAMES="your_blob_id.public.blob.vercel-storage.com"

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN="your_mercadopago_access_token_here"
MERCADOPAGO_WEBHOOK_SECRET="your_mercadopago_webhook_secret_here"
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="your_mercadopago_public_key_here"

# Bearer secret for POST /api/internal/reconcile (host scheduler). The route refuses every request while this is unset.
# Generate a long random value, e.g.: openssl rand -hex 32
RECONCILE_SECRET="your_long_random_reconcile_secret_here"

# Public order creation rate limit (optional). In-memory fixed window per client
# address: the first x-forwarded-for value, or one shared "unknown" bucket when the
# header is absent. Only trustworthy behind a reverse proxy that overwrites that
# header. State resets on restart and is not shared across instances.
# Defaults: 8 new orders per 600 seconds.
# CHECKOUT_RATE_LIMIT_MAX="8"
# CHECKOUT_RATE_LIMIT_WINDOW_SECONDS="600"

# Destructive semester purge (permanently deletes data; keep "false" outside controlled maintenance)
ALLOW_DESTRUCTIVE_PURGE="false"
